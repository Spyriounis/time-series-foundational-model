# Copy to .env and fill in. Only the sources you pull need their keys.

# Where the store lives. Keep it outside cloud-synced folders.
TSFM_DATA_DIR=~/tsfm-data

# OANDA v20: token from the account portal; practice or live.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# eToro: Settings > Trading > API Key Management.
ETORO_API_KEY=
ETORO_USER_KEY=

# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# https://www.eia.gov/opendata/register.php
EIA_API_KEY=
